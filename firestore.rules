rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userKey() {
      return signedIn() && request.auth.token.get('appUserId', null) is string
        ? request.auth.token.appUserId
        : request.auth.uid;
    }

    function isOwner() {
      return signedIn() && request.auth.token.get('role', null) == 'owner'
        && profileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function sameUser(value) {
      return signedIn() && (value == request.auth.uid || value == userKey());
    }

    function validLeadData(data) {
      return data.businessName is string
        && data.contactName is string
        && data.email is string
        && data.phone is string
        && data.source in ['facebook', 'google', 'referral', 'walk-in', 'other']
        && data.stage in ['new', 'contacted', 'proposal', 'negotiation', 'won', 'lost']
        && data.assignedTo is string
        && data.createdBy is string
        && data.estimatedValue is number;
    }

    function validClientData(data) {
      return data.businessName is string
        && data.ownerName is string
        && data.email is string
        && data.phone is string
        && data.location is string
        && data.industry is string
        && data.contractSigned is bool
        && data.onboardingCompleted is bool
        && data.createdBy is string;
    }

    function validProjectData(data) {
      return data.name is string
        && data.clientId is string
        && data.packageId is string
        && data.status in ['not-started', 'in-progress', 'completed', 'on-hold', 'waiting-client', 'delivered']
        && data.milestones is list
        && data.dueDate is string
        && data.startDate is string
        && data.assignedTo is string
        && data.createdBy is string;
    }

    function validInvoiceData(data) {
      return data.invoiceNumber is string
        && data.clientId is string
        && data.items is list
        && data.subtotal is number
        && data.total is number
        && data.amountPaid is number
        && data.status in ['draft', 'sent', 'partially-paid', 'overdue', 'paid']
        && data.dueDate is string
        && data.issuedDate is string
        && data.createdBy is string;
    }

    function validPaymentData(data) {
      return data.invoiceId is string
        && data.amount is number
        && data.amount > 0
        && data.method in ['eft', 'cash', 'card', 'other']
        && data.reference is string
        && data.paidAt is string
        && data.createdBy is string;
    }

    function leadAccessible(leadId) {
      return signedIn()
        && leadId is string
        && exists(/databases/$(database)/documents/leads/$(leadId))
        && sameUser(get(/databases/$(database)/documents/leads/$(leadId)).data.assignedTo);
    }

    function clientAccessible(clientId) {
      return signedIn()
        && clientId is string
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && (
          sameUser(get(/databases/$(database)/documents/clients/$(clientId)).data.createdBy)
          || (
            get(/databases/$(database)/documents/clients/$(clientId)).data.leadId is string
            && leadAccessible(get(/databases/$(database)/documents/clients/$(clientId)).data.leadId)
          )
          || (
            get(/databases/$(database)/documents/clients/$(clientId)).data.visibleTo is list
            && get(/databases/$(database)/documents/clients/$(clientId)).data.visibleTo.hasAny([request.auth.uid, userKey()])
          )
        );
    }

    function projectAccessible(projectId) {
      return signedIn()
        && projectId is string
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && sameUser(get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo);
    }

    function invoiceAccessible(invoiceId) {
      return signedIn()
        && invoiceId is string
        && exists(/databases/$(database)/documents/invoices/$(invoiceId))
        && (
          (
            get(/databases/$(database)/documents/invoices/$(invoiceId)).data.projectId is string
            && projectAccessible(get(/databases/$(database)/documents/invoices/$(invoiceId)).data.projectId)
          )
          || clientAccessible(get(/databases/$(database)/documents/invoices/$(invoiceId)).data.clientId)
        );
    }

    function activityAccessible(entityType, entityId) {
      return entityType == 'lead' && leadAccessible(entityId)
        || entityType == 'client' && clientAccessible(entityId)
        || entityType == 'project' && projectAccessible(entityId)
        || entityType == 'invoice' && invoiceAccessible(entityId);
    }

    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && uid == request.auth.uid);
      // Identity and role creation/recovery run through verified server endpoints.
      allow create: if false;
      allow update: if (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'name', 'phone', 'avatar', 'commissionRate', 'isActive', 'updatedAt']))
        || (signedIn()
          && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'name', 'phone', 'avatar', 'updatedAt']));
      allow delete: if isOwner();
    }

    match /leads/{leadId} {
      allow read: if isOwner() || sameUser(resource.data.assignedTo);
      allow create: if validLeadData(request.resource.data)
        && request.resource.data.stage != 'won'
        && request.resource.data.get('clientId', null) == null
        && (isOwner()
        || (sameUser(request.resource.data.assignedTo) && sameUser(request.resource.data.createdBy)));
      allow update: if validLeadData(request.resource.data)
        && (request.resource.data.stage != 'won' || resource.data.stage == 'won')
        && request.resource.data.get('clientId', null) == resource.data.get('clientId', null)
        && (isOwner()
        || (sameUser(resource.data.assignedTo)
          && sameUser(request.resource.data.assignedTo)
          && request.resource.data.createdBy == resource.data.createdBy));
      allow delete: if isOwner() || sameUser(resource.data.assignedTo);
    }

    match /clients/{clientId} {
      allow read: if isOwner() || clientAccessible(clientId);
      allow create: if validClientData(request.resource.data)
        && (isOwner() || sameUser(request.resource.data.createdBy));
      allow update: if validClientData(request.resource.data)
        && (isOwner()
        || (clientAccessible(clientId)
          && request.resource.data.diff(resource.data).affectedKeys().hasNone(['createdBy', 'leadId', 'visibleTo'])));
      allow delete: if isOwner();
    }

    match /projects/{projectId} {
      allow read: if isOwner() || sameUser(resource.data.assignedTo);
      allow create: if validProjectData(request.resource.data)
        && (isOwner()
        || (sameUser(request.resource.data.assignedTo) && sameUser(request.resource.data.createdBy)));
      allow update: if validProjectData(request.resource.data)
        && (isOwner()
        || (sameUser(resource.data.assignedTo)
          && sameUser(request.resource.data.assignedTo)
          && request.resource.data.diff(resource.data).affectedKeys().hasNone(['clientId', 'createdBy'])));
      allow delete: if isOwner();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner() || invoiceAccessible(invoiceId);
      allow create, update: if isOwner() && validInvoiceData(request.resource.data);
      allow delete: if isOwner();
    }

    match /payments/{paymentId} {
      allow read: if isOwner() || invoiceAccessible(resource.data.invoiceId);
      allow create, update: if isOwner() && validPaymentData(request.resource.data);
      allow delete: if isOwner();
    }

    match /commissions/{commissionId} {
      allow read: if isOwner() || sameUser(resource.data.agentId);
      allow create, update, delete: if isOwner();
    }

    match /activities/{activityId} {
      allow read: if isOwner()
        || sameUser(resource.data.createdBy)
        || activityAccessible(resource.data.entityType, resource.data.entityId);
      allow create: if isOwner()
        || (sameUser(request.resource.data.createdBy)
          && activityAccessible(request.resource.data.entityType, request.resource.data.entityId));
      allow update, delete: if isOwner() || sameUser(resource.data.createdBy);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner() || sameUser(resource.data.userId);
      allow create: if isOwner() || sameUser(request.resource.data.userId);
    }

    match /push_tokens/{tokenId} {
      allow read: if isOwner() || sameUser(resource.data.userId);
      allow create: if isOwner() || sameUser(request.resource.data.userId);
      allow update: if isOwner() || sameUser(resource.data.userId) || sameUser(request.resource.data.userId);
      allow delete: if isOwner() || sameUser(resource.data.userId);
    }

    match /settings/{settingId} {
      allow read, write: if isOwner();
    }

    match /project_shares/{shareId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
